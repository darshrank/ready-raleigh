# Backend secrets. Copy to backend/.env when the FastAPI service exists.
# Server-side only: never prefix these with NEXT_PUBLIC_ and never commit the real file.

# --- Gemini (AI Commander, briefings, debrief) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- ElevenLabs (voice briefings, radio mode, narrated debrief) ---
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Voice library -> pick a voice -> copy its ID
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Tiger Data / Tiger Cloud (PostgreSQL + Timescale + PostGIS) ---
# Tiger Cloud console -> your service -> Connect -> connection string
DATABASE_URL=postgres://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require

# --- Solana devnet (civic-proof plan receipts) ---
# No API key needed for devnet. Generate a throwaway keypair with `solana-keygen new`,
# fund it with `solana airdrop 2 --url devnet`, and paste the JSON array or base58 secret.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PAYER_SECRET_KEY=

# --- Live data (optional) ---
# NOAA/NWS API needs no key, only a User-Agent with contact info.
NWS_USER_AGENT="faultline-hackathon (you@example.com)"
# Only for NOAA Climate Data Online history: https://www.ncdc.noaa.gov/cdo-web/token
NOAA_CDO_TOKEN=
# Free, instant: https://api.census.gov/data/key_signup.html (unlocks block-group demographics in data prep)
CENSUS_API_KEY=

# --- Data Streaming challenge (optional) ---
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# --- Realtime rooms at scale (optional; FastAPI WebSockets work without it) ---
REDIS_URL=
