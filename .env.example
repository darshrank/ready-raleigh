# Server
PORT=3000
# Set to 1 to serve HTTPS with a self-signed cert (phones need it for mic/camera)
HTTPS=0
# Public base URL used in QR codes (our domain or a tunnel). Leave empty for LAN auto-detect.
PUBLIC_URL=

# Gemini (coach, Local Intel structuring, image estimates). Empty = mock fallback.
GEMINI_API_KEY=
# ElevenLabs TTS (broadcast voice). Empty = captions only.
ELEVENLABS_API_KEY=
# Tiger Data / Timescale Cloud Postgres (TimescaleDB + PostGIS)
DATABASE_URL=
# Mapillary v4 street photos
MAPILLARY_TOKEN=
# US Census Data API key (free: https://api.census.gov/data/key_signup.html) — required since the API now rejects keyless requests
CENSUS_API_KEY=
