# Copy to .env and fill in. Never commit .env.
# Gemini (server/src/ai/gemini.ts). Empty key = templates everywhere. Empty models = the defaults below.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_BROADCAST=
ELEVENLABS_VOICE_NARRATOR=
# News desk anchors (voice ids from ElevenLabs > My Voices > ... > Copy voice ID). Empty = a default voice.
# America News' anchor is a woman (default Sarah); Bharat News' is a man speaking Hindi (default George).
ELEVENLABS_VOICE_AMERICA=
ELEVENLABS_VOICE_BHARAT=
# Tiger Data (Tiger Cloud) connection string, postgres://...?sslmode=require. Empty = plays kept in memory.
DATABASE_URL=
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_SECRET_KEY=
CENSUS_API_KEY=
PORT=8787
# Live USGS gauges, NOAA flood stages and NWS weather (no keys). false turns the poller off.
LIVE_FEEDS=true
VITE_SERVER_URL=http://localhost:8787
VITE_FEATURE_VOICE=true
VITE_FEATURE_AI=true
# Where the app and server load data from: /data (default, real Raleigh data) or /data/fixtures (small test set).
VITE_DATA_BASE=/data

# Public base URL for room QR codes (our domain or a tunnel). Empty = this machine's LAN address.
PUBLIC_URL=
