{
  "name": "ready-raleigh",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,rooms -c cyan,magenta \"vite\" \"npm:dev:rooms\"",
    "dev:web": "vite",
    "dev:rooms": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && wrangler dev --port 8787",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p worker",
    "deploy": "npm run build && wrangler deploy",
    "data": "npm run data:fetch && npm run data:build",
    "data:fetch": ".venv/bin/python data-prep/fetch_overture.py && .venv/bin/python data-prep/fetch_dem.py && .venv/bin/python data-prep/hydrology.py",
    "data:census": ".venv/bin/python data-prep/fetch_census.py && .venv/bin/python data-prep/build.py",
    "data:build": ".venv/bin/python data-prep/build.py",
    "optimal": "tsx scripts/optimal.ts"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.4.0",
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/geo-layers": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/mapbox": "^9.4.0",
    "@deck.gl/react": "^9.4.0",
    "h3-js": "^4.5.0",
    "maplibre-gl": "^6.11.2",
    "partysocket": "^1.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-map-gl": "^8.1.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
