# Frontend config. Copy to web/.env.local. Only public, non-secret values belong here.

# FastAPI backend (rooms, Gemini, ElevenLabs, Tiger Data, Solana all go through it)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public site URL, e.g. your GoDaddy Registry domain once it points at Vercel
NEXT_PUBLIC_SITE_URL=http://localhost:3000
